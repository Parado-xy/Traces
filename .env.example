# Node loads .env explicitly when present. Never commit actual credentials.
TRACE_DB=data/trace-shadow.sqlite
BIKEINDEX_TOKEN=
# read_user scope; approved app (or authorized own-bike test) required for sends.
BIKEINDEX_NOTIFY_APPROVED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Keep these credentials matched to EBAY_ENV (sandbox or production).
# Sandbox by default. Recovery use needs explicit provider purpose confirmation.
EBAY_ENV=sandbox
EBAY_PRODUCTION_APPROVED=false
RETENTION_DAYS=30

# Live checks use data/integration.sqlite by default, independent of TRACE_DB.
# npm run integration -- status prints presence flags, never secret values.
# The integration runner has no notification-send command.
